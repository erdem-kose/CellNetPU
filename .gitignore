# =============================================
# CellNetPU - Xilinx ISE & MicroBlaze .gitignore
# =============================================
# Only hand-written source files are tracked.
# Everything else under src/ISE/ is generated
# from .mhs, .xco, .xise and can be rebuilt.
# =============================================

# --- Eclipse / SDK metadata ---
.metadata

# --- ISE generated project files ---
*.gise
*.cdk

# --- Synthesis products ---
*.ngc
*.ngr
*.ncd
*.pcf
*.syr
*.bld
*.blc
*.lso
*.xrpt
*.srp

# --- Place & Route / Timing ---
*.par
*.twr
*.twx
*.xpi
*.map
*.pad
*.unroutes
*.xwbt

# --- Bitstreams & binaries ---
*.bit
*.mcs
*.spi
*.bin
*.elf
*.axf

# --- Simulation artifacts ---
*.wdb
*.vcd
*.ghw
*.vvp
*.asdb
*.isim
isim/
work/

# --- Object files & executables ---
*.o
*.a
*.so
*.dll
*.exe
*.jar

# --- Logs & reports ---
*.log
*.log.bak
*.rpt
*.html
*.csv
*.out

# --- Temp & backup ---
*~
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Xilinx tool directories ---
_xmsgs/
_ngo/
_impact/
_xilbld/
.Xil/
xst/
xlnx_auto_*/
iseconfig/
.webtalk*

# --- License files ---
*.lic
*.license
.flexlm*

# --- IDE local settings ---
.vscode/
.idea/

# --- Python ---
__pycache__/
*.pyc

